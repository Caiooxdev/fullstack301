<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro de Produtos</title>
    <!-- Carrega o CSS separado da pasta public. -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Titulo exibido na pagina. -->
    <h1>Cadastro de Produtos</h1>
    <!-- Formulario: action indica a rota; method POST envia dados para cadastro. -->
    <form action="/cadastrar" method="POST">
    <p>Nome do produto:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="text" name="nome" required>
    <p>Preço:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="number" name="preco" required min="0" step="0.01">
    <p>Quantidade:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="number" name="quantidade" required min="0" step="1">
        <br><br>
        <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
        <input type="submit" value="Cadastrar">
    </form>
    <!-- Link para navegar entre formulario e lista. -->
    <p><a href="/lista">Ver produtos cadastrados</a></p>
</body>
</html>
