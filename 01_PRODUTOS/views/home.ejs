<!DOCTYPE html>
<html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Cadastro de produtos</title><link rel="stylesheet" href="/style.css"></head>
<body>
  <!-- ALTERAR NA PROVA: CABECALHO E TITULO -->
  <header><h1>Cadastro de Produtos</h1></header>
  <main class="container">
    <section class="cartao">
      <h2>Novo cadastro</h2>
      <!-- ALTERAR NA PROVA: ACTION e CAMPOS, mantendo os mesmos nomes no servidor -->
      <form class="formulario" action="/cadastrar" method="POST">
        <!-- ALTERAR NA PROVA: CAMPO NOME DO PRODUTO (name deve ser igual ao servidor.js) -->
        <label for="nome">Nome do produto</label>
        <input id="nome" name="nome" type="text"  required>
        <!-- ALTERAR NA PROVA: CAMPO PREÇO (name deve ser igual ao servidor.js) -->
        <label for="preco">Preço</label>
        <input id="preco" name="preco" type="number" min="0" step="0.01" required>
        <!-- ALTERAR NA PROVA: CAMPO QUANTIDADE (name deve ser igual ao servidor.js) -->
        <label for="quantidade">Quantidade</label>
        <input id="quantidade" name="quantidade" type="number" min="0" step="1" required>
        <button type="submit">Cadastrar</button>
      </form>
    </section>
    <section class="cartao">
      <h2>Lista de produtos</h2>
      <!-- EJS: mostra os registros encontrados com find() no MongoDB -->
      <ul class="registros">
        <% if (registros.length === 0) { %><li>Nenhum registro cadastrado.</li><% } %>
        <% registros.forEach(function(item) { %>
          <li><%= item.nome %> — <%= item.preco %> — <%= item.quantidade %></li>
        <% }); %>
      </ul>
    </section>
  </main>
</body></html>
