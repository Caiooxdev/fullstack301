<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro de Pessoas</title>
    <!-- Carrega o CSS separado da pasta public. -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Titulo exibido na pagina. -->
    <h1>Cadastro de Pessoas</h1>
    <!-- Formulario: action indica a rota; method POST envia dados para cadastro. -->
    <form action="/cadastrar" method="POST">
    <p>Nome:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="text" name="nome" required>
    <p>Sobrenome:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="text" name="sobrenome" required>
    <p>E-mail:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="email" name="email" required>
        <br><br>
        <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
        <input type="submit" value="Cadastrar">
    </form>
    <!-- Link para navegar entre formulario e lista. -->
    <p><a href="/lista">Ver pessoas cadastrados</a></p>
</body>
</html>
