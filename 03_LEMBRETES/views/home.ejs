<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <title>Cadastro de Lembretes</title>
    <!-- Carrega o CSS separado da pasta public. -->
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <!-- Titulo exibido na pagina. -->
    <h1>Cadastro de Lembretes</h1>
    <!-- Formulario: action indica a rota; method POST envia dados para cadastro. -->
    <form action="/cadastrar" method="POST">
    <p>Título:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="text" name="titulo" required>
    <p>Descrição:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="text" name="descricao" required>
    <p>Data:</p>
    <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
    <input type="date" name="data" required>
        <br><br>
        <!-- Campo do formulario: name deve ser igual ao campo lido em req.body. -->
        <input type="submit" value="Cadastrar">
    </form>
    <!-- Link para navegar entre formulario e lista. -->
    <p><a href="/lista">Ver lembretes cadastrados</a></p>
</body>
</html>
